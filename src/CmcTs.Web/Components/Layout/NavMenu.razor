<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ITS INF</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Tổng quan
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                Dự án
            </NavLink>
        </div>

        <AuthorizeView Roles="@nameof(GlobalRole.Admin)">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    Quản lý người dùng
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/personnel-stats">
                    Thống kê nhân sự
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="nav-account">
                <div class="nav-account-name">@context.User.Identity?.Name</div>
                <form method="post" action="/auth/logout">
                    <button type="submit" class="nav-logout">Đăng xuất</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
