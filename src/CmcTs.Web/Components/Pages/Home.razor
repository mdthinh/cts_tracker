@page "/"
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@inject IDbContextFactory<CmcTsDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Tổng quan - ITS INF</PageTitle>

<h1>Tổng quan</h1>
@if (!IsAdmin)
{
    <p class="hint">Chỉ hiển thị manday/doanh thu của riêng bạn và các dự án bạn tham gia.</p>
}

@if (Summary is null)
{
    <p>Đang tải...</p>
}
else
{
    <div class="kpi-grid">
        <div class="kpi kpi-manday">
            <div class="label">Manday lũy kế NTC @Summary.FiscalYearLabel</div>
            <div class="value">@Summary.MandayThisFiscalYear.ToString("N1")<span class="unit">manday</span></div>
        </div>
        <div class="kpi kpi-revenue-quarter">
            <div class="label">Doanh thu quý Q@(Summary.CurrentQuarter) (@QuarterRangeLabel(Summary.CurrentQuarter))</div>
            <div class="value">@Summary.RevenueCurrentQuarter.ToString("N0")<span class="unit">đ</span></div>
        </div>
        <div class="kpi kpi-revenue-fy">
            <div class="label">Doanh thu lũy kế NTC @Summary.FiscalYearLabel</div>
            <div class="value">@Summary.RevenueThisFiscalYear.ToString("N0")<span class="unit">đ</span></div>
        </div>
        <div class="kpi kpi-active">
            <div class="label">Dự án đang triển khai</div>
            <div class="value">@Summary.StatusCounts.InProgress<span class="unit">dự án</span></div>
            <div class="foot">Nháp: <b>@Summary.StatusCounts.Draft</b> &middot; Hoàn thành: <b>@Summary.StatusCounts.Completed</b></div>
        </div>
    </div>

    <div class="row-2col">
        <div class="card">
            <div class="card-head">
                <div>
                    <h2>Doanh thu theo quý</h2>
                    <div class="card-sub">NTC @Summary.FiscalYearLabel &middot; đơn vị: đồng</div>
                </div>
            </div>
            <p class="hint">Chỉ tính dự án đã bấm "Đánh dấu hoàn thành", ghi nhận vào quý chứa ngày hoàn thành.</p>
            <svg class="chart-svg" viewBox="0 0 560 190" preserveAspectRatio="xMidYMid meet">
                <line class="axis-line" x1="8" y1="162" x2="552" y2="162" />
                @BuildChartBars(Summary)
            </svg>
        </div>

        <div class="card">
            <h2>Mức độ hoàn thành</h2>
            <div class="card-sub">Trung bình toàn bộ dự án, theo trọng số manday</div>
            <div class="ring-wrap">
                <div class="ring" style="--pct:@AverageProgress"><div class="hole"><span class="ring-n">@AverageProgress%</span><span class="ring-s">hoàn thành</span></div></div>
                <div class="ring-stats">
                    <div><span class="dot dot-draft"></span>Nháp: <b>@Summary.StatusCounts.Draft</b></div>
                    <div><span class="dot dot-ontrack"></span>Đúng tiến độ: <b>@Summary.StatusCounts.OnTrack</b></div>
                    <div><span class="dot dot-atrisk"></span>Rủi ro: <b>@Summary.StatusCounts.AtRisk</b></div>
                    <div><span class="dot dot-delayed"></span>Trễ hạn: <b>@Summary.StatusCounts.Delayed</b></div>
                    <div><span class="dot dot-completed"></span>Hoàn thành: <b>@Summary.StatusCounts.Completed</b></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Dự án (@Summary.Projects.Count)</h2>
        <div class="table-scroll">
            <table class="proj-table">
                <thead>
                    <tr>
                        <th>MVV</th>
                        <th>Dự án</th>
                        <th>NTC</th>
                        <th>Khối</th>
                        <th>Trưởng dự án</th>
                        <th>Tiến độ</th>
                        <th class="num">Manday (TT/KH)</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Summary.Projects)
                    {
                        <tr @onclick="() => GoToProject(p.ProjectId)">
                            <td class="muted">@(p.CaseCode ?? "-")</td>
                            <td class="proj-name">@p.Name</td>
                            <td>@p.FiscalYear</td>
                            <td>@p.BusinessUnit</td>
                            <td>@(p.ProjectLeadName ?? "-")</td>
                            <td>
                                <div class="bar-row">
                                    <div class="bar-track"><div class="bar-fill" style="width:@(p.Progress)%"></div></div>
                                    <span class="bar-pct">@(p.Progress)%</span>
                                </div>
                            </td>
                            <td class="num">@p.MandayActual.ToString("N1") / @p.MandayPlan.ToString("N1")</td>
                            <td><span class="chip chip-@p.Status">@StatusLabel(p.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card">
    <h2>Lịch sử báo cáo công việc</h2>
    @if (IsAdmin)
    {
        <p class="hint">Toàn bộ báo cáo công việc từ tất cả dự án, mới nhất trước. Bấm 1 dòng để mở dự án ở tab mới.</p>
    }
    else
    {
        <p class="hint">Báo cáo công việc của các dự án bạn tham gia, mới nhất trước. Bấm 1 dòng để mở dự án ở tab mới.</p>
    }

    @if (Reports.Count == 0)
    {
        <p class="hint">Chưa có báo cáo công việc nào.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Ngày báo cáo</th>
                        <th>Người báo cáo</th>
                        <th>Dự án</th>
                        <th>Công việc</th>
                        <th class="num">Tiến độ</th>
                        <th class="num">Manday</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Reports)
                    {
                        <tr @onclick="() => OpenProjectInNewTabAsync(r.Task.ProjectId)">
                            <td class="nowrap">@r.ReportDate.ToString("dd/MM/yyyy")</td>
                            <td class="nowrap">@r.ReportedByUser.DisplayName</td>
                            <td>@r.Task.Project.Name<br /><span class="muted">MVV @(r.Task.Project.CaseCode ?? "-")</span></td>
                            <td>@r.Task.Name</td>
                            <td class="num">@r.ProgressPercent%</td>
                            <td class="num">@r.MandayReported.ToString("N1")</td>
                            <td class="note">@r.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (IsTruncated)
        {
            <p class="hint">Chỉ hiển thị @Reports.Count báo cáo gần nhất.</p>
        }
    }
</div>

@code {
    private const int MaxRows = 200;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private DashboardSummary? Summary;
    private List<WorkReport> Reports { get; set; } = new();
    private bool IsTruncated;
    private bool IsAdmin;
    private int? CurrentUserId;

    private int AverageProgress =>
        Summary is null || Summary.Projects.Count == 0
            ? 0
            : Summary.Projects.Sum(p => p.MandayPlan) > 0
                ? (int)Math.Round(Summary.Projects.Sum(p => p.Progress * p.MandayPlan) / Summary.Projects.Sum(p => p.MandayPlan))
                : (int)Math.Round(Summary.Projects.Average(p => (decimal)p.Progress));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        IsAdmin = authState.User.IsAdmin();
        CurrentUserId = authState.User.GetUserId();

        // Admin thấy toàn công ty như trước (scopeToUserId: null). Nhân sự thường chỉ thấy manday/
        // doanh thu/dự án của riêng mình — cùng phạm vi "là Member của dự án" dùng ở trang Dự án và
        // CanViewProjectAsync, tránh 3 nơi tự định nghĩa 3 kiểu phạm vi khác nhau.
        var scopeToUserId = IsAdmin ? (int?)null : (CurrentUserId ?? -1);
        Summary = await DashboardService.GetSummaryAsync(DateTime.UtcNow, scopeToUserId);

        await using var db = await DbFactory.CreateDbContextAsync();
        var reportsQuery = db.WorkReports
            .Include(r => r.ReportedByUser)
            .Include(r => r.Task).ThenInclude(t => t.Project)
            .AsQueryable();

        if (!IsAdmin)
        {
            var userId = CurrentUserId ?? -1;
            reportsQuery = reportsQuery.Where(r => r.Task.Project.Members.Any(m => m.UserId == userId));
        }

        Reports = await reportsQuery
            .OrderByDescending(r => r.CreatedAt)
            .Take(MaxRows + 1)
            .ToListAsync();

        IsTruncated = Reports.Count > MaxRows;
        if (IsTruncated)
        {
            Reports = Reports.Take(MaxRows).ToList();
        }
    }

    private void GoToProject(int projectId) => Navigation.NavigateTo($"/projects/{projectId}");

    private async Task OpenProjectInNewTabAsync(int projectId)
    {
        var absoluteUrl = Navigation.ToAbsoluteUri($"/projects/{projectId}").ToString();
        await JS.InvokeVoidAsync("open", absoluteUrl, "_blank");
    }

    // Dựng phần bar+label bằng chuỗi rồi render qua MarkupString thay vì viết trực tiếp thẻ SVG
    // <text> trong Razor — Razor coi <text>/</text> là cú pháp riêng của nó (không nhận attribute)
    // nên viết trực tiếp bị lỗi biên dịch bất kể hoa/thường. Toàn bộ nội dung chèn vào đây đều là
    // số đã format hoặc chuỗi cố định, không có input người dùng nên an toàn khi render thô.
    private static MarkupString BuildChartBars(DashboardSummary summary)
    {
        var maxRevenue = summary.QuarterlyRevenue.Count > 0 ? summary.QuarterlyRevenue.Max(q => q.Amount) : 0m;
        var chartMax = maxRevenue > 0 ? maxRevenue * 1.2m : 1m;
        var groupWidth = 544d / 4;

        var sb = new System.Text.StringBuilder();
        foreach (var q in summary.QuarterlyRevenue)
        {
            var cx = 8 + groupWidth * (q.Quarter - 1) + groupWidth / 2;
            var barHeight = chartMax > 0 ? (double)(q.Amount / chartMax) * 132 : 0;
            var y = 162 - barHeight;
            var isCurrent = q.Quarter == summary.CurrentQuarter;
            var barClass = isCurrent ? "bar-current" : "bar";
            var quarterLabel = $"Q{q.Quarter}{(isCurrent ? " • hiện tại" : "")} ({QuarterRangeLabel(q.Quarter)})";

            sb.Append($"<rect class=\"{barClass}\" x=\"{cx - 32:F1}\" y=\"{y:F1}\" width=\"64\" height=\"{Math.Max(barHeight, 1):F1}\" rx=\"4\" />");
            sb.Append($"<text class=\"val-label\" x=\"{cx:F1}\" y=\"{y - 8:F1}\" text-anchor=\"middle\">{q.Amount:N0}</text>");
            sb.Append($"<text class=\"axis-label\" x=\"{cx:F1}\" y=\"178\" text-anchor=\"middle\">{quarterLabel}</text>");
        }

        return new MarkupString(sb.ToString());
    }

    private static string QuarterRangeLabel(int quarter) => quarter switch
    {
        1 => "T4-T6",
        2 => "T7-T9",
        3 => "T10-T12",
        4 => "T1-T3",
        _ => "",
    };

    private static string StatusLabel(ProjectStatus status) => status switch
    {
        ProjectStatus.Draft => "Nháp",
        ProjectStatus.OnTrack => "Đúng tiến độ",
        ProjectStatus.AtRisk => "Rủi ro",
        ProjectStatus.Delayed => "Trễ hạn",
        ProjectStatus.Completed => "Hoàn thành",
        _ => status.ToString(),
    };
}
