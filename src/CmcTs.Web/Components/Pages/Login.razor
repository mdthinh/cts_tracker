@page "/login"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout

<PageTitle>Đăng nhập - CMC TS</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-brand">
            <span class="login-mark">TS</span>
            <div>
                <h1>CMC TS</h1>
                <p>Theo dõi tiến độ dự án</p>
            </div>
        </div>

        @if (HasError)
        {
            <div class="login-alert">@ErrorMessage</div>
        }

        <form method="post" action="/auth/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label for="username">Tài khoản AD</label>
            <input id="username" type="text" name="username" autocomplete="username" required autofocus />

            <label for="password">Mật khẩu</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required />

            <button type="submit">Đăng nhập</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string ErrorMessage => Error switch
    {
        "invalid" => "Sai tài khoản hoặc mật khẩu.",
        "disabled" => "Tài khoản đã bị vô hiệu hóa, liên hệ Admin.",
        _ => "Đăng nhập không thành công.",
    };
}
