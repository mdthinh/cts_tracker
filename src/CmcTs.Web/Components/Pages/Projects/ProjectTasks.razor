@page "/projects/{Id:int}/tasks"
@rendermode InteractiveServer
@inject IDbContextFactory<CmcTsDbContext> DbFactory

<PageTitle>Công việc - CMC TS</PageTitle>

@if (Project is null)
{
    <p>Đang tải...</p>
}
else
{
    <div class="eyebrow">@Project.BusinessUnit &middot; NTC @Project.FiscalYear</div>
    <h1>Cây công việc — @Project.Name</h1>
    <p class="hint">
        Gán người phụ trách từng công việc sẽ có ở bước tiếp theo. Trang này hiện chỉ để xem lại
        cây công việc đã import từ file Dự toán.
    </p>

    @if (RootTasks.Count == 0)
    {
        <p class="hint">Dự án chưa import Dự toán.</p>
    }
    else
    {
        <table class="task-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Công việc</th>
                    <th class="num">Manday (KH)</th>
                    <th class="num">Chi phí</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var root in RootTasks)
                {
                    <TaskTreeRow Node="root" Depth="0" />
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? Project;
    private List<TaskItem> RootTasks { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Project = await db.Projects.FindAsync(Id);
        if (Project is null)
        {
            return;
        }

        // Chỉ cần load hết Task của dự án vào cùng 1 DbContext — EF Core tự "fixup" quan hệ
        // ParentTask/Children 2 chiều đã khai báo trong CmcTsDbContext, không cần tự nối cây bằng
        // tay. Làm thêm bước tự nối (như code cũ) khiến mỗi node bị thêm vào Children 2 lần: 1 lần
        // do EF tự fixup, 1 lần do code tự thêm — gây nhân đôi toàn bộ cây khi hiển thị (bug thật
        // đã gặp khi test).
        var allTasks = await db.Tasks
            .Where(t => t.ProjectId == Id)
            .OrderBy(t => t.SourceRow)
            .ToListAsync();

        RootTasks = allTasks.Where(t => t.ParentTaskId is null).ToList();
    }
}
