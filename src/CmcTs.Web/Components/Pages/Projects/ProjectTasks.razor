@page "/projects/{Id:int}/tasks"
@rendermode InteractiveServer
@inject IDbContextFactory<CmcTsDbContext> DbFactory
@inject ITaskPermissionService PermissionService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Công việc - ITS INF</PageTitle>

@if (Project is null)
{
    <p>Đang tải...</p>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">MVV @(Project.CaseCode ?? "-") &middot; @Project.BusinessUnit &middot; NTC @Project.FiscalYear</div>
            <h1>Cây công việc — @Project.Name</h1>
        </div>
        <a class="btn-secondary" href="/projects/@Id/report">Báo cáo công việc</a>
    </div>
    <p class="hint">
        Chỉ Admin, Trưởng dự án, hoặc người đã được gán vào nhánh cha mới gán được người phụ trách
        cho từng dòng bên dưới.
    </p>

    @if (RootTasks.Count == 0)
    {
        <p class="hint">Dự án chưa import Dự toán.</p>
    }
    else
    {
        <table class="task-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Công việc</th>
                    <th class="num">Manday (KH/TT)</th>
                    <th class="num">Chi phí</th>
                    <th>Tiến độ</th>
                    <th>Phụ trách</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var root in RootTasks)
                {
                    <TaskTreeRow Node="root" Depth="0" Members="Members" CanAssign="CanEditTask" OnAssigneeChanged="OnAssigneeChangedAsync" />
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? Project;
    private List<TaskItem> RootTasks { get; set; } = new();
    private List<User> Members { get; set; } = new();
    private HashSet<int> EditableTaskIds { get; set; } = new();
    private bool IsAdmin;
    private int? CurrentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        IsAdmin = authState.User.IsAdmin();
        CurrentUserId = authState.User.GetUserId();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Project = await db.Projects
            .Include(p => p.Members).ThenInclude(m => m.User)
            .SingleOrDefaultAsync(p => p.Id == Id);
        if (Project is null)
        {
            return;
        }

        Members = Project.Members.Select(m => m.User).OrderBy(u => u.DisplayName).ToList();

        // Chỉ cần load hết Task của dự án vào cùng 1 DbContext — EF Core tự "fixup" quan hệ
        // ParentTask/Children 2 chiều đã khai báo trong CmcTsDbContext, không cần tự nối cây bằng
        // tay (làm vậy sẽ nhân đôi mỗi node — bug thật đã gặp và sửa trước đó).
        var allTasks = await db.Tasks
            .Include(t => t.AssigneeUser)
            .Where(t => t.ProjectId == Id)
            .OrderBy(t => t.SourceRow)
            .ToListAsync();

        RootTasks = allTasks.Where(t => t.ParentTaskId is null).ToList();

        // Dùng service dùng chung (có test) thay vì tự viết tay so sánh CurrentUserId (int?) —
        // bug thật đã gặp: so 2 giá trị int? với nhau, khi CurrentUserId null thì "null == null"
        // bị C# coi là true, cấp nhầm quyền sửa mọi task chưa gán ai cho bất kỳ user nào.
        EditableTaskIds = await PermissionService.GetEditableTaskIdsAsync(Id, CurrentUserId ?? -1, IsAdmin);
    }

    private bool CanEditTask(TaskItem task) => EditableTaskIds.Contains(task.Id);

    private async Task OnAssigneeChangedAsync((TaskItem Task, int? NewAssigneeUserId) change)
    {
        // Xác thực lại quyền ngay tại lúc lưu thay vì chỉ tin vào việc dropdown chỉ hiển thị khi
        // CanAssign (EditableTaskIds tính từ lúc load trang) — phòng quyền đã đổi giữa lúc mở trang
        // và lúc đổi người phụ trách.
        var editableIds = await PermissionService.GetEditableTaskIdsAsync(Id, CurrentUserId ?? -1, IsAdmin);
        if (!editableIds.Contains(change.Task.Id))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Tasks.FindAsync(change.Task.Id);
        if (entity is null)
        {
            return;
        }

        entity.AssigneeUserId = change.NewAssigneeUserId;
        await db.SaveChangesAsync();
        await LoadAsync();
    }
}
