@page "/admin/users"
@attribute [Authorize(Roles = nameof(GlobalRole.Admin))]
@rendermode InteractiveServer
@inject IDbContextFactory<CmcTsDbContext> DbFactory
@inject IUserProvisioningService Provisioning

<PageTitle>Quản lý người dùng - CMC TS</PageTitle>

<h1>Quản lý người dùng</h1>
<p class="hint">
    Tài khoản chỉ xuất hiện trong bảng bên dưới sau khi họ đã tự đăng nhập ít nhất 1 lần,
    hoặc bạn chủ động tìm trên AD và thêm vào trước.
</p>

<AdUserPicker OnUserSelected="AddUserAsync"
              IsDisabled="r => ExistingSamAccounts.Contains(r.SamAccountName)"
              SelectLabel="Thêm vào hệ thống"
              DisabledLabel="Đã có trong hệ thống" />

<table class="user-table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Tài khoản</th>
            <th>Loại</th>
            <th>Phòng ban</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Đồng bộ AD gần nhất</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in UserList)
        {
            <tr>
                <td>@u.DisplayName</td>
                <td>@u.SamAccountName</td>
                <td class="muted">@(u.IsLocalAccount ? "Local" : "AD")</td>
                <td>@u.Department</td>
                <td>
                    <select value="@u.GlobalRole.ToString()" @onchange="e => ChangeRoleAsync(u, e.Value!.ToString()!)">
                        <option value="@nameof(GlobalRole.Viewer)">Viewer</option>
                        <option value="@nameof(GlobalRole.Admin)">Admin</option>
                    </select>
                </td>
                <td>
                    <button type="button" class="@(u.IsActive ? "btn-active" : "btn-inactive")" @onclick="() => ToggleActiveAsync(u)">
                        @(u.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")
                    </button>
                </td>
                <td class="muted">@(u.LastSyncedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<User> UserList { get; set; } = new();
    private HashSet<string> ExistingSamAccounts { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadUsersAsync();
    }

    private async Task ReloadUsersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        UserList = await db.Users.OrderBy(u => u.DisplayName).ToListAsync();
        ExistingSamAccounts = UserList.Select(u => u.SamAccountName).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private async Task AddUserAsync(AdUserInfo adUser)
    {
        await Provisioning.GetOrCreateStubAsync(adUser);
        await ReloadUsersAsync();
    }

    private async Task ChangeRoleAsync(User user, string newRole)
    {
        if (!Enum.TryParse<GlobalRole>(newRole, out var role) || role == user.GlobalRole)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(user.Id);
        if (entity is null)
        {
            return;
        }

        entity.GlobalRole = role;
        await db.SaveChangesAsync();
        user.GlobalRole = role;
    }

    private async Task ToggleActiveAsync(User user)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(user.Id);
        if (entity is null)
        {
            return;
        }

        entity.IsActive = !entity.IsActive;
        await db.SaveChangesAsync();
        user.IsActive = entity.IsActive;
    }
}
