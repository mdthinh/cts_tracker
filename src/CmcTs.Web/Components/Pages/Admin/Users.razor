@page "/admin/users"
@attribute [Authorize(Roles = nameof(GlobalRole.Admin))]
@rendermode InteractiveServer
@inject IDbContextFactory<CmcTsDbContext> DbFactory
@inject IUserProvisioningService Provisioning
@inject IJSRuntime JS

<PageTitle>Quản lý người dùng - ITS INF</PageTitle>

<h1>Quản lý người dùng</h1>
<p class="hint">
    Tài khoản chỉ xuất hiện trong bảng bên dưới sau khi họ đã tự đăng nhập ít nhất 1 lần,
    hoặc bạn chủ động tìm trên AD và thêm vào trước.
</p>

<AdUserPicker OnUserSelected="AddUserAsync"
              IsDisabled="r => ExistingSamAccounts.Contains(r.SamAccountName)"
              SelectLabel="Thêm vào hệ thống"
              DisabledLabel="Đã có trong hệ thống" />

@if (DeleteError is not null)
{
    <div class="error-box">@DeleteError</div>
}

<table class="user-table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Tài khoản</th>
            <th>Loại</th>
            <th>Phòng ban</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Đồng bộ AD gần nhất</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in UserList)
        {
            <tr>
                <td>@u.DisplayName</td>
                <td>@u.SamAccountName</td>
                <td class="muted">@(u.IsLocalAccount ? "Local" : "AD")</td>
                <td>@u.Department</td>
                <td>
                    <select value="@u.GlobalRole.ToString()" @onchange="e => ChangeRoleAsync(u, e.Value!.ToString()!)">
                        <option value="@nameof(GlobalRole.Viewer)">Viewer</option>
                        <option value="@nameof(GlobalRole.Admin)">Admin</option>
                    </select>
                </td>
                <td>
                    <button type="button" class="@(u.IsActive ? "btn-active" : "btn-inactive")" @onclick="() => ToggleActiveAsync(u)">
                        @(u.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")
                    </button>
                </td>
                <td class="muted">@(u.LastSyncedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                <td><button type="button" class="btn-delete" @onclick="() => DeleteUserAsync(u)">Xóa</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<User> UserList { get; set; } = new();
    private HashSet<string> ExistingSamAccounts { get; set; } = new();
    private string? DeleteError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadUsersAsync();
    }

    private async Task ReloadUsersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        UserList = await db.Users.OrderBy(u => u.DisplayName).ToListAsync();
        ExistingSamAccounts = UserList.Select(u => u.SamAccountName).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private async Task AddUserAsync(AdUserInfo adUser)
    {
        await Provisioning.GetOrCreateStubAsync(adUser);
        await ReloadUsersAsync();
    }

    private async Task ChangeRoleAsync(User user, string newRole)
    {
        if (!Enum.TryParse<GlobalRole>(newRole, out var role) || role == user.GlobalRole)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(user.Id);
        if (entity is null)
        {
            return;
        }

        entity.GlobalRole = role;
        await db.SaveChangesAsync();
        user.GlobalRole = role;
    }

    private async Task ToggleActiveAsync(User user)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Users.FindAsync(user.Id);
        if (entity is null)
        {
            return;
        }

        entity.IsActive = !entity.IsActive;
        await db.SaveChangesAsync();
        user.IsActive = entity.IsActive;
    }

    private async Task DeleteUserAsync(User user)
    {
        DeleteError = null;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Xóa tài khoản \"{user.DisplayName}\" ({user.SamAccountName})? Không thể hoàn tác.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Kiểm tra trước xem user đang gắn với dự án/task nào để báo tên cụ thể, thay vì để
        // FK Restrict chặn lúc SaveChanges rồi chỉ báo chung chung "có lỗi".
        var usage = await DescribeUsageAsync(db, user.Id);
        if (usage is not null)
        {
            DeleteError = $"Không thể xóa \"{user.DisplayName}\": {usage} Gỡ khỏi các dự án/task liên quan trước, " +
                "hoặc dùng nút \"Vô hiệu hóa\" thay vì xóa.";
            return;
        }

        var entity = await db.Users.FindAsync(user.Id);
        if (entity is null)
        {
            return;
        }

        db.Users.Remove(entity);
        try
        {
            await db.SaveChangesAsync();
            await ReloadUsersAsync();
        }
        catch (DbUpdateException)
        {
            // Phòng trường hợp có liên kết khác không kiểm tra ở DescribeUsageAsync (vd AuditLog).
            DeleteError = $"Không thể xóa \"{user.DisplayName}\" vì vẫn đang được tham chiếu ở nơi khác trong hệ thống. " +
                "Dùng nút \"Vô hiệu hóa\" thay vì xóa.";
        }
    }

    private static async Task<string?> DescribeUsageAsync(CmcTsDbContext db, int userId)
    {
        var asLead = await db.Projects.Where(p => p.ProjectLeadUserId == userId).Select(p => p.Name).ToListAsync();
        var asCreator = await db.Projects.Where(p => p.CreatedByUserId == userId).Select(p => p.Name).ToListAsync();
        var asMember = await db.ProjectMembers.Where(m => m.UserId == userId).Select(m => m.Project.Name).ToListAsync();
        var taskCount = await db.Tasks.CountAsync(t => t.AssigneeUserId == userId);

        var parts = new List<string>();
        if (asLead.Count > 0)
        {
            parts.Add($"Trưởng dự án của: {string.Join(", ", asLead)}.");
        }
        if (asCreator.Count > 0)
        {
            parts.Add($"Người tạo dự án: {string.Join(", ", asCreator)}.");
        }
        var memberOnly = asMember.Except(asLead).ToList();
        if (memberOnly.Count > 0)
        {
            parts.Add($"Thành viên của: {string.Join(", ", memberOnly)}.");
        }
        if (taskCount > 0)
        {
            parts.Add($"Đang được gán {taskCount} công việc.");
        }

        return parts.Count > 0 ? string.Join(" ", parts) : null;
    }
}
